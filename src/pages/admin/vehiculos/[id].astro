---
import Layout from '../../../layouts/Layout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import VehicleForm from '../../../components/admin/VehicleForm';
import { guardAdmin } from '../../../lib/server/guard';

const { id } = Astro.params;
if (!id || !/^[a-zA-Z0-9-]+$/.test(id)) return Astro.redirect('/admin/vehiculos');

const guard = await guardAdmin(Astro);
if (guard instanceof Response) return guard;
const { user } = guard;
---

<Layout
	title="Editar vehículo — Panel"
	description="Editar un vehículo de Carmexio."
>
	<AdminShell user={user} pathname={Astro.url.pathname} title="Editar vehículo" backHref="/admin/vehiculos">
		<VehicleForm mode="edit" vehicleId={id} client:load />
	</AdminShell>
</Layout>