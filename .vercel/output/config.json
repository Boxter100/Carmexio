{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/vehiculos/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/vehiculos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/vehiculos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/me/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/vehicles/([^/]+?)/availability/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/vehicles/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/vehicles/?$",
			"dest": "_render"
		},
		{
			"src": "^/comisiones/?$",
			"dest": "_render"
		},
		{
			"src": "^/financiamiento/?$",
			"dest": "_render"
		},
		{
			"src": "^/garage/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/garage/?$",
			"dest": "_render"
		},
		{
			"src": "^/inversiones/?$",
			"dest": "_render"
		},
		{
			"src": "^/membresias/?$",
			"dest": "_render"
		},
		{
			"src": "^/nosotros/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}